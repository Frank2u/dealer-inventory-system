datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin, operator
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String         @id @default(uuid())
  name            String
  sku             String         @unique
  brand           String
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  lotSize         Int            @default(1)
  unitType        String         @default("pcs") // pcs, box, kg, etc.
  purchasePrice   Float
  sellingPrice     Float
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  mrp             Float          @default(0.0)
  discountPercent String         @default("")
  currentStock    Int            @default(0)
  minStockAlert   Int            @default(5)
  gstPercent      Float          @default(0.0)
  expiryDate      DateTime?
  stockEntries    StockEntry[]
  deliveryItems   DeliveryItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([supplierId, name])
}

model Shop {
  id             String     @id @default(uuid())
  shopCode       String     @default("")
  name           String
  ownerName      String
  phone          String
  alternatePhone String?
  address        String
  area           String
  gstNumber      String?
  creditLimit    Float      @default(0)
  notes          String?
  currentDue     Float      @default(0)
  username       String     @default("")
  password       String     @default("")
  deliveries     Delivery[]
  payments       Payment[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Supplier {
  id           String       @id @default(uuid())
  name         String       @unique
  address      String       @default("")
  phone        String       @default("")
  gstNumber    String       @default("")
  products     Product[]
  stockEntries StockEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model AreaMapping {
  id         String   @id @default(uuid())
  areaName   String   @unique
  codePrefix String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StockEntry {
  id            String   @id @default(uuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  invoiceNumber String
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  remainingStock Int      @default(0)
  costPrice     Float
  date          DateTime @default(now())
  expiryDate    DateTime?
  notes         String?
  deliveryItems DeliveryItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Delivery {
  id             String         @id @default(uuid())
  deliveryNumber String         @unique // invoice number
  shopId         String
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deliveryDate   DateTime       @default(now())
  totalAmount    Float
  paidAmount     Float          @default(0)
  remainingDue   Float
  paymentStatus  String         @default("unpaid") // paid, partial, unpaid
  status         String         @default("ordered") // ordered, delivered
  totalGst       Float          @default(0)
  gstPaidByShop  Float          @default(0)
  gstPaidByMe    Float          @default(0)
  items          DeliveryItem[]
  payments       Payment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model DeliveryItem {
  id          String   @id @default(uuid())
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockEntryId String?
  stockEntry   StockEntry? @relation(fields: [stockEntryId], references: [id], onDelete: SetNull)
  quantity    Int
  lotSize     Int      @default(1)
  price       Float
  totalAmount Float
  gstPercent  Float    @default(0)
  gstAmount   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id            String    @id @default(uuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deliveryId    String?
  delivery      Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  paidAmount    Float
  paymentDate   DateTime  @default(now())
  paymentMethod String    @default("CASH") // CASH, UPI, CARD, CHEQUE, BANK_TRANSFER
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
